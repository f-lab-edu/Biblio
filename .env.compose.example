# `gcloud auth application-default login` 실행 후 생성되는
# ADC 파일의 절대 경로 또는 프로젝트 기준 상대 경로
ADC_CREDENTIALS_PATH=/absolute/path/to/application_default_credentials.json

# docker-compose에서 공통으로 쓰는 Postgres 접속 정보
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# 선택: 임베딩 모델 원본을 직접 지정할 때 사용
# 기본 패키징 동작은 첫 실행 시 `BAAI/bge-m3`를 다운로드하고 캐시에 저장함
# EMBEDDING_MODEL_ARTIFACT_PATH=BAAI/bge-m3

# 선택: pipeline-worker가 청크 임베딩 메타데이터로 기록할 모델 버전 값
# managed embedding endpoint를 쓸 때는 위 EMBEDDING_MODEL_ARTIFACT_PATH와 맞추는 것을 권장
# EMBEDDING_MODEL_VERSION=BAAI/bge-m3
