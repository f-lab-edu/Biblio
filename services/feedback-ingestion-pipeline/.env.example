GCP_PROJECT_ID=your-gcp-project-id
FIP_HTTP_ADDRESS=0.0.0.0:8080
FIP_HTTP_PATH=/feedback/events
FIP_METRICS_ADDRESS=0.0.0.0:9598
FIP_METRICS_SCRAPE_INTERVAL_SEC=5
GCS_FEEDBACK_LOG_BUCKET_NAME=your-feedback-log-bucket
GOOGLE_APPLICATION_CREDENTIALS=/creds/adc.json
FIP_SINK_BATCH_MAX_EVENTS=100
FIP_SINK_FLUSH_TIMEOUT_SEC=10
FIP_SINK_TIMEOUT_SEC=30
FIP_RETRY_MAX_ATTEMPTS=5
FIP_RETRY_INITIAL_BACKOFF_SEC=1
FIP_RETRY_MAX_BACKOFF_SEC=60
FIP_DISK_BUFFER_MAX_SIZE_MB=512

FIP_LOCAL_OUTPUT_DIR=/tmp/biblio-fip-output
FIP_FIXTURE_INPUT_PATH=./fixtures/feedback_event.valid.jsonl
