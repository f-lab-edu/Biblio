# ── Database (PostgreSQL + asyncpg) ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55433/app

# ── Broker ───────────────────────────────────────────────────────────
# pgmq = production (uses PGMQ extension on same Postgres)
# inmemory = test only
BROKER_TYPE=pgmq

# ── GCP ──────────────────────────────────────────────────────────────
GCP_PROJECT_ID=biblio-dev
GCS_VIDEO_BUCKET_NAME=biblio-video-dev-001

# ── STT (Google Cloud Speech-to-Text v2 BatchRecognize) ─────────────
STT_LOCATION=us
STT_MODEL_VERSION=chirp_3
# Empty = default recognizer (_). Custom: projects/{project}/locations/{location}/recognizers/{id}
STT_RECOGNIZER=
STT_SUBMIT_TIMEOUT_SEC=30
STT_OPERATION_TIMEOUT_SEC=900

# ── Vision (Vertex AI Gemini) ────────────────────────────────────────
VISION_LOCATION=global
VISION_MODEL=gemini-3.1-flash-lite
VISION_TIMEOUT_SEC=15
VISION_MAX_OUTPUT_TOKENS=2048

# ── Embedding ────────────────────────────────────────────────────────
# For local dev, run: python tools/fake_embedding_server.py
EMBEDDING_API_URL=http://localhost:8090
EMBEDDING_MODEL_VERSION=BAAI/bge-m3
EMBEDDING_TIMEOUT_SEC=30
EMBEDDING_BATCH_SIZE=16

# ── Worker ───────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
MAX_RETRIES=3
POLL_INTERVAL_SEC=1.0
DOWNLOAD_TIMEOUT_SEC=60
CHUNK_MAX_TOKENS=300
CHUNK_OVERLAP_SENTENCES=1
