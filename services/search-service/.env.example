# Required
JWT_SECRET_KEY=your-secret-key
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/biblio
EMBEDDING_API_URL=http://localhost:8081/embed

# GCP / Vertex AI (ADC for auth)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# LLM Provider
LLM_PROVIDER=gemini
GEMINI_MODEL_NAME=gemini-2.0-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=512

# Search tuning (defaults shown)
# SEARCH_TOP_K=20
# FINAL_TOP_K=5
# RRF_K=60

# Timeout & retry (defaults shown)
# EMBEDDING_TIMEOUT_SEC=2
# EMBEDDING_MAX_RETRIES=1
# LLM_TIMEOUT_SEC=3
# LLM_MAX_RETRIES=1
