project_id  = "biblio-perf-example"
region      = "asia-northeast3"
zone        = "asia-northeast3-a"
name_prefix = "biblio-perf"
image_tag   = "0000000"

db_password    = "replace-with-postgres-password"
jwt_secret_key = "replace-with-jwt-secret-key"

cloudrun_subnet_cidr = "10.20.1.0/24"
postgres_subnet_cidr = "10.20.2.0/24"
embedding_subnet_cidr = "10.20.3.0/24"

enable_managed_embedding_cloud_run = false
embedding_vm_machine_type          = "e2-standard-4"
embedding_vm_model_disk_size_gb    = 100

# 모델 버전은 타임스탬프를 붙여 관리한다.
# 경로의 마지막 조각이 ModelRelease 버전 이름이 되므로, 버전마다 다른 이름을 쓴다.
model_artifact_path             = "/models/bge-m3-20260615T000000KST"
embedding_model_artifact_prefix = "models"
local_model_cache_root          = "/models"
