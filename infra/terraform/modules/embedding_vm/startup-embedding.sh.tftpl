#!/usr/bin/env bash
set -euo pipefail

MODEL_DEVICE="/dev/disk/by-id/google-model-cache"
COMPOSE_DIR="/opt/biblio/managed-embedding-endpoint"
MODELS_DIR="${local_model_cache_root}"
DATABASE_URL_SECRET_NAME="${database_url_secret_name}"

apt-get update
apt-get install -y ca-certificates curl jq

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/debian/gpg \
  -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc

cat > /etc/apt/sources.list.d/docker.sources <<DOCKER_REPOSITORY
Types: deb
URIs: https://download.docker.com/linux/debian
Suites: $(. /etc/os-release && echo "$VERSION_CODENAME")
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
DOCKER_REPOSITORY

apt-get update
apt-get install -y \
  docker-ce \
  docker-ce-cli \
  containerd.io \
  docker-buildx-plugin \
  docker-compose-plugin

systemctl enable --now docker

mkdir -p "$MODELS_DIR" "$COMPOSE_DIR"

metadata_value() {
  curl -fsSL \
    -H "Metadata-Flavor: Google" \
    "http://metadata.google.internal/computeMetadata/v1/$1"
}

ACCESS_TOKEN="$(
  metadata_value instance/service-accounts/default/token \
    | jq -r '.access_token'
)"

fetch_database_url() {
  curl -fsSL \
    -H "Authorization: Bearer $ACCESS_TOKEN" \
    "https://secretmanager.googleapis.com/v1/$DATABASE_URL_SECRET_NAME/versions/latest:access" \
    | jq -r '.payload.data' \
    | base64 --decode
}

if ! blkid "$MODEL_DEVICE" >/dev/null 2>&1; then
  mkfs.ext4 -F "$MODEL_DEVICE"
fi

if ! grep -q "$MODEL_DEVICE $MODELS_DIR" /etc/fstab; then
  echo "$MODEL_DEVICE $MODELS_DIR ext4 defaults,nofail 0 2" >> /etc/fstab
fi

mountpoint -q "$MODELS_DIR" || mount "$MODELS_DIR"
chown 999:999 "$MODELS_DIR"

DATABASE_URL="$(fetch_database_url)"

cat > "$COMPOSE_DIR/.env" <<ENV
DATABASE_URL=$${DATABASE_URL}
MODEL_ARTIFACT_PATH=${model_artifact_path}
MODEL_ARTIFACT_BACKEND=gcs
GCS_ML_ARTIFACT_BUCKET_NAME=${gcs_ml_artifact_bucket_name}
MODEL_ARTIFACT_PREFIX=${model_artifact_prefix}
LOCAL_MODEL_CACHE_ROOT=${local_model_cache_root}
MAX_CONCURRENCY=${max_concurrency}
%{ if inference_threads != null }INFERENCE_THREADS=${inference_threads}
%{ endif ~}
SEARCH_REQUEST_LIMIT=${search_request_limit}
VIDEO_PREPROCESS_REQUEST_LIMIT=${video_preprocess_request_limit}
SEARCH_WAIT_TIMEOUT_SEC=${search_wait_timeout_sec}
VIDEO_PREPROCESS_WAIT_TIMEOUT_SEC=${video_preprocess_wait_timeout_sec}
ENV

cat > "$COMPOSE_DIR/docker-compose.yml" <<COMPOSE
services:
  managed-embedding-endpoint:
    image: ${image_url}
    restart: unless-stopped
    ports:
      - "8000:8000"
    env_file:
      - .env
    volumes:
      - ${local_model_cache_root}:${local_model_cache_root}
COMPOSE

REGISTRY_HOST="$(echo '${image_url}' | cut -d/ -f1)"
printf '%s' "$ACCESS_TOKEN" \
  | docker login \
      --username oauth2accesstoken \
      --password-stdin \
      "https://$REGISTRY_HOST"

cat > /etc/systemd/system/biblio-managed-embedding-endpoint.service <<UNIT
[Unit]
Description=Biblio managed embedding endpoint
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=$COMPOSE_DIR
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now biblio-managed-embedding-endpoint.service

%{ if enable_warp_proxy }
# --- WARP egress proxy (wireproxy) for YouTube download ---
# YouTube가 GCP 데이터센터 IP를 봇으로 차단하므로, yt-dlp 트래픽을 Cloudflare
# WARP 터널로 우회시킨다. wireproxy가 WARP(WireGuard)를 SOCKS5로 노출하고,
# 워커가 VPC를 통해 이 VM의 1080 포트로 접속한다. (설계: YOUTUBE_PROXY_URL)
WIREPROXY_DIR="/opt/wireproxy"
WGCF_VERSION="2.2.29"
WIREPROXY_VERSION="1.0.9"
mkdir -p "$${WIREPROXY_DIR}"
cd "$${WIREPROXY_DIR}"

if [ ! -x "$${WIREPROXY_DIR}/wgcf" ]; then
  curl -fsSL -o wgcf \
    "https://github.com/ViRb3/wgcf/releases/download/v$${WGCF_VERSION}/wgcf_$${WGCF_VERSION}_linux_amd64"
  chmod +x wgcf
fi

if [ ! -x "$${WIREPROXY_DIR}/wireproxy" ]; then
  curl -fsSL -o wireproxy.tar.gz \
    "https://github.com/pufferffish/wireproxy/releases/download/v$${WIREPROXY_VERSION}/wireproxy_linux_amd64.tar.gz"
  tar xzf wireproxy.tar.gz
  rm -f wireproxy.tar.gz
fi

# WARP 계정은 한 번만 등록하고 재부팅 시 재사용한다(단일 인스턴스라 키 공유 문제 없음).
if [ ! -f "$${WIREPROXY_DIR}/wgcf-account.toml" ]; then
  ./wgcf register --accept-tos
fi
if [ ! -f "$${WIREPROXY_DIR}/wgcf-profile.conf" ]; then
  ./wgcf generate
fi

# SOCKS5를 모든 인터페이스에 열어 워커가 VPC 내부 IP로 접근하게 한다.
if [ ! -f "$${WIREPROXY_DIR}/wireproxy.conf" ]; then
  { cat wgcf-profile.conf; printf '\n[Socks5]\nBindAddress = 0.0.0.0:1080\n'; } > wireproxy.conf
fi
chmod 600 wgcf-account.toml wgcf-profile.conf wireproxy.conf

cat > /etc/systemd/system/biblio-warp-proxy.service <<UNIT
[Unit]
Description=Biblio WARP egress proxy (wireproxy) for YouTube download
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=$${WIREPROXY_DIR}/wireproxy -c $${WIREPROXY_DIR}/wireproxy.conf
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now biblio-warp-proxy.service
%{ endif }
